      "options": [
        {
          "value": "yes",
          "label": "Yes, let's do it now",
          "emoji": "👍"
        },
        {
          "value": "later",
          "label": "Later works better",
          "emoji": "🕒"
        },
        {
          "value": "no",
          "label": "No, thanks",
          "emoji": "👋",
          "goto": "DECLINED"
        }
      ]
    },
    {
      "id": "CB",
      "step": 0,
      "type": "text",
      "showIf": {
