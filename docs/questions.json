  "questions": [
    {
      "id": "INTRO",
      "step": 0,
      "type": "message",
      "icon": "wave",
      "landing": true,
      "title": "Welcome, and thank you for being here 👋",
      "body": [
        "I'm Rohith, a product management student. I'm studying what happens after someone gets a price for health insurance: what makes it clear, what makes people hesitate, and what helps them decide."
      ],
      "whyTitle": "Why your answers matter",
      "why": [
        "Many people get a health insurance quote and never go ahead, often because it's hard to tell what the plan will actually pay for. Your experience, good or bad, shows where quotes leave people unsure. That helps make quotes clearer and more honest, not pushier."
      ],
      "facts": [
        "About 5 minutes",
        "Speak or type, whichever is easier",
        "No right or wrong answers"
      ],
      "smallPrint": "This is an independent student study. It isn't run by an insurance company.",
      "primary": {
        "label": "Get started",
        "value": "yes"
      }
    },
    {
      "id": "C00",
      "step": 0,
      "type": "welcome",
      "icon": "wave",
      "title": "First, a quick sign-in",
      "lead": "So each person answers once, and you can pick up where you left off.",
      "whyTitle": "Why we ask you to sign in",
      "why": [
        "So each person answers once. With Google, you can also pick up where you left off on another device.",
        "With Google we only receive your name and email: never your password, contacts or anything else in your account.",
        "Your email or number is kept separately from your answers. Rohith sees it only if you ask for the guide or a time to get back to you; otherwise it's erased when you finish."
      ],
      "consent": "",
      "primary": {
        "label": "Yes, let's start",
        "value": "yes"
      },
      "secondary": {
        "label": "No thanks",
        "value": "no",
        "goto": "DECLINED"
      },
      "signinPrompt": "Sign in with Google in one tap to begin.",
      "titleSignedIn": "Hi {first}, thanks for being here 👋",
      "leadSignedIn": "So each person answers once, and you can pick up where you left off. Start whenever you're ready.",
      "contactLabel": "Your email or mobile number",
      "contactPlaceholder": "e.g. priya@gmail.com or 98765 43210",
      "contactHint": "Outside India? Start your number with + and the country code, e.g. +971.",
      "nameLabel": "Your first name (optional)",
      "contactButton": "Continue",
      "contactToggle": "Use your email or mobile number instead"
    },
    {
      "id": "W1",
      "step": 0,
      "type": "single",
      "title": "Do you have about 5 minutes now?",
