      "goto": "CALLBACK",
      "title": "When is a good time to get back to you?",
      "helper": "We'll send you the link again then. Nothing else.",
      "fields": [
        {
          "name": "when",
          "label": "A good time",
          "placeholder": "e.g. Tomorrow after 6 pm"
        },
        {
          "name": "contact",
          "label": "WhatsApp number or email",
          "placeholder": "e.g. 98765 43210"
        }
      ]
    },
