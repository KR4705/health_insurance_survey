  "reviewStatus": "awaiting final approval; not production",
  "reviewChanges": [
    "W1 before C00; later branch requests structured email reminder without sign-in",
    "H9 as themed tiles, max three choices",
    "Q7 confidence wording and clear five-point anchors",
    "Voice nonblocking 'I understood' and auto-continue; original transcript not displayed",
    "P12c measures understanding of cover",
    "X13 asks for useful information beyond quote, gently suggesting examples",
    "X14 only email opt-ins for guide and/or research findings",
    "Short landing introduction; no referrals or thank-you emails"
  ],
  "voiceExperience": {
    "mode": "voice_or_type",
